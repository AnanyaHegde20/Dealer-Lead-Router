    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^14.27.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
