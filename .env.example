# Firebase web-app configuration (Firebase console → Project settings → Your apps)
# Copy this file to `.env` and fill in your OWN values.
#
#   cp .env.example .env
#
# NEVER commit `.env` — it is ignored by .gitignore. These placeholders are safe.

VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional: point the app at local emulators while developing.
# (When unset, the app talks to the real project from the values above.)
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Used only by scripts/import_legacy_leads.mjs (server side, never bundled) ---
# Production import (service-account key kept OUTSIDE git):
#   GOOGLE_APPLICATION_CREDENTIALS=/secure/path/serviceAccount.json
#   GCLOUD_PROJECT=your-project-id
# Emulator import (no credentials needed):
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#   GCLOUD_PROJECT=demo-dealer-router
